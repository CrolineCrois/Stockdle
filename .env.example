# Copy to .env (repo root) and fill in. Never commit .env.

# The judge and v0's training fakes. Set ONE of these keys (Anthropic wins if
# both are set). Without either, the game uses the rule-based mock judge.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# SIP_JUDGE=auto                       # auto | claude | openai | mock
# SIP_JUDGE_MODEL=claude-sonnet-5-5    # when the judge is Claude
# SIP_OPENAI_JUDGE_MODEL=gpt-4o-mini   # when the judge is OpenAI
# SIP_OPENAI_FAKES_MODEL=gpt-4o        # writes v0's training fakes
# Check your setup (and which models your key can use): cd backend && .venv/bin/python -m judge.check

# Gameplay tuning (defaults shown)
# SIP_TIMER_BASE_S=20
# SIP_TIMER_MIN_S=10
# SIP_TIMER_BOUNTY_BONUS_S=5
# SIP_NOVELTY_THRESHOLD=0.35
# SIP_BOUNTY_FRACTION=0.15

# Comma-separated RSS feeds to scrape
# SIP_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.npr.org/1001/rss.xml

# Admin token for maintenance endpoints
# SIP_ADMIN_TOKEN=sneak-demo
