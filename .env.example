# Copy to .env (repo root) and fill in. Never commit .env.

# The judge. Without a key the game uses the rule-based mock judge.
ANTHROPIC_API_KEY=
# SIP_JUDGE=auto                 # auto | claude | mock
# SIP_JUDGE_MODEL=claude-sonnet-5-5

# Gameplay tuning (defaults shown)
# SIP_TIMER_BASE_S=20
# SIP_TIMER_MIN_S=10
# SIP_TIMER_BOUNTY_BONUS_S=5
# SIP_NOVELTY_THRESHOLD=0.35
# SIP_BOUNTY_FRACTION=0.15

# Comma-separated RSS feeds to scrape
# SIP_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.npr.org/1001/rss.xml

# Admin token for maintenance endpoints
# SIP_ADMIN_TOKEN=sneak-demo
